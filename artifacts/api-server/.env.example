# ─── Required ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk authentication (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Mobile JWT secret — used to sign/verify our own mobile-app session tokens
# (separate from Clerk). Generate with: openssl rand -base64 48
MOBILE_JWT_SECRET=

# ─── Admin Configuration ────────────────────────────────────────────────────
# Comma-separated list of email addresses that are auto-promoted to the "admin"
# role on first login.  This replaces the old hardcoded admin email list.
# In production this MUST be set; an empty value means NO user gets admin rights
# automatically (you must promote them manually via the DB or Clerk metadata).
ADMIN_EMAILS=admin@example.com,ops@example.com

# Email address for low-stock alert emails sent to the admin.
ADMIN_EMAIL=admin@example.com

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. In production, this MUST
# be set to your exact Vercel URL(s). If unset in production, the API
# silently allows ALL origins with credentials (a security hole).
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ─── Optional: Image Uploads (Cloudinary) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional: Transactional Emails (Resend) ───────────────────────────────
# Required for order confirmations, status updates, abandoned-cart recovery,
# stock alerts, and seller subscription reminders.
RESEND_API_KEY=
# FROM address for outgoing emails. Use a verified domain (verify at
# https://resend.com/domains). Falls back to onboarding@resend.dev which
# will land in spam — set this in production.
EMAIL_FROM=Tree Friend <noreply@treefriend.com>
# Reply-To address (defaults to helptreefriend@gmail.com if unset).
EMAIL_REPLY_TO=helptreefriend@gmail.com

# ─── Optional: WhatsApp Notifications (Twilio) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ─── Optional: Rate Limiting (Upstash Redis) ───────────────────────────────
# Required for production on Vercel (serverless). Without Redis, the rate
# limiter falls back to in-memory (per-instance, NOT shared across Lambda
# invocations — effectively no rate limiting). Get these from Vercel →
# Storage → Upstash Integration → Connect to project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: Vercel Cron Authentication ──────────────────────────────────
# Required if deploying to Vercel. Vercel sends this as a Bearer token on
# every cron invocation. Generate with: openssl rand -base64 32
# Without this, cron jobs (seller subscription expiry, monthly archive,
# low-stock alerts, abandoned-cart recovery) cannot run on Vercel.
CRON_SECRET=

# ─── Optional: Render Keep-Alive ───────────────────────────────────────────
RENDER_EXTERNAL_URL=https://your-api.onrender.com

# ─── bKash Tokenized Checkout (Part 2 of 4 — see PART2_HANDOFF.md) ─────────
# Overrides the bKash API host. Defaults to bKash's SANDBOX host in code if
# unset (lib/bkash.ts) — deliberately NOT production, so a forgotten env var
# fails safely instead of silently hitting a real merchant account. Set this
# explicitly to bKash's production host in production.
BKASH_API_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Merchant app_key/app_secret/username/password are NOT set via env vars —
# they're stored (encrypted) in the platform_payment_config DB table via the
# admin UI (routes/platformPaymentConfig.ts, Part 1), not as process env.
# This file just documents that BKASH_API_BASE_URL exists; the credentials
# themselves live in the database, same as every other seller/platform
# payment config in this app.

# ─── bKash B2C/Disbursement (Part 3 of 4 — see PART3_HANDOFF.md) ───────────
# Overrides the base URL used ONLY for disburseToSeller() (seller payouts),
# separate from BKASH_API_BASE_URL above (Checkout). Defaults to
# BKASH_API_BASE_URL itself if unset, per lib/bkash.ts's own doc comment —
# but this is a placeholder, not a verified endpoint: independent sources
# disagree on whether bKash's B2C/payout product lives under the same
# tokenized.bka.sh host as Checkout, or under a separate domain entirely
# (bKash's own public reference site surfaces B2C endpoints under
# "openfin.bka.sh" instead, a seemingly distinct product line with its own
# token/grant endpoint). Set this explicitly once real merchant-onboarding
# paperwork confirms which product line/host this platform's B2C access was
# actually issued for — see lib/bkash.ts's BKASH_B2C_BASE_URL doc comment
# and PART3_HANDOFF.md for the full writeup.
BKASH_B2C_API_BASE_URL=

# Base URL used to build frontend-facing links this server generates (bKash's
# callback redirect target, order-confirmation emails, referral share links,
# etc.) — same variable several existing routes already read
# (routes/referrals.ts, routes/sitemap.ts, lib/email.ts) despite not
# previously being documented here.
APP_URL=https://your-frontend.vercel.app

# 32-byte (or longer) random string used to encrypt seller/platform payment
# credentials at rest (lib/credentialEncryption.ts). Required in production;
# without it, saving any payment config will fail loudly rather than storing
# credentials unencrypted.
CREDENTIAL_ENCRYPTION_KEY=

# ─── Courier Webhooks (routes/courierWebhooks.ts) ──────────────────────────
# Required. Shared secret both /webhooks/courier/pathao and
# /webhooks/courier/steadfast check on every request, via either an
# `X-Courier-Webhook-Secret` header or a `?secret=` query param -- before
# any DB lookup. A matched webhook can flip an order to "delivered" and
# trigger a real seller payout, so this must be set in production; the app
# fails loudly at startup if it isn't. Generate one with:
# openssl rand -base64 32
# Configure the SAME value on the courier's own dashboard when setting up
# each webhook URL (as a query param on the Callback URL, since neither
# courier's dashboard lets you attach a custom header).
COURIER_WEBHOOK_SECRET=

# Optional. If set, additionally verifies Pathao's `X-PATHAO-Signature`
# header against this value (Pathao Merchant Dashboard > Developer API >
# Webhook Integration > Secret). Layered on top of, not instead of,
# COURIER_WEBHOOK_SECRET above. Leave unset to rely on the shared secret only.
PATHAO_WEBHOOK_SECRET=

# Optional. If set, additionally requires an `Authorization: Bearer <token>`
# header on the Steadfast webhook matching this value. Not an officially
# documented Steadfast feature (their docs don't specify a webhook-auth
# convention) -- this is the de facto pattern community Steadfast
# integrations use, supported here for parity. Layered on top of, not
# instead of, COURIER_WEBHOOK_SECRET above. Leave unset to rely on the
# shared secret only.
STEADFAST_WEBHOOK_BEARER_TOKEN=

# ─── Optional: AI Assistant (TreeBot / Multi-provider) ──────────────────────
# v3.1: TreeBot supports multiple AI providers with automatic fallback.
#   1. Gemini (primary) — best Bangla support, but restrictive free tier
#      on new GCP projects (gemini-3.6-flash = 20 RPD).
#   2. Groq (fallback) — 14,400 RPD free tier, extremely fast (LPU hardware).
#      Used automatically when Gemini's quota is exhausted.
#
# Get a FREE Gemini API key at https://aistudio.google.com/apikey
# Get a FREE Groq API key at https://console.groq.com (no credit card needed)
#
# Leave BOTH empty to disable TreeBot (the /api/ai/* routes return 503).
# You can set just ONE if you prefer a single provider.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Comma-separated list of providers to try, in order.
# Default: "gemini,groq" (Gemini first, Groq fallback)
# Other options:
#   "groq"             — Groq only (skip Gemini)
#   "gemini"           — Gemini only (no fallback)
#   "groq,gemini"      — Groq first, Gemini fallback
AI_PROVIDERS=gemini,groq

# Optional. Which Gemini model to use. If unset, auto-discovers available
# models via the ListModels API (recommended — Google frequently deprecates
# models and new GCP projects only have access to 3.x models).
# Only set this if you want to force a specific model.
#AI_MODEL=gemini-2.5-flash

# Optional. Which Groq model to use. Defaults to trying in order:
#   1. llama-3.3-70b-versatile (best quality, function calling)
#   2. llama-3.1-8b-instant (faster, cheaper)
#GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Generation parameters (shared by all providers).
# Default temperature 0.4 (factual plant care rewards low temperature).
# Default max_tokens 2048 (raised from 1024 in v3.0 — care guides can be long).
#AI_TEMPERATURE=0.4
#AI_MAX_TOKENS=2048

# Optional. Max retries on transient errors (5xx, network) per model.
# 429 quota errors are NOT retried — they trigger fallback to the next model.
#AI_MAX_RETRIES=3

# Optional. Cooldown (ms) for a model after it returns 429.
# During cooldown, the model is skipped entirely. Default: 60s.
#AI_QUOTA_COOLDOWN_MS=60000

# Optional. Max number of prior turns to send to the AI as conversation
# history. Higher = better continuity, higher token cost. Default: 10.
# When history exceeds AI_SUMMARY_THRESHOLD (default 12), older messages
# are summarized and the summary is injected into the system prompt.
AI_MAX_HISTORY=10
#AI_SUMMARY_THRESHOLD=12
#AI_RESUMMARIZE_INTERVAL=8

# Optional. pg_trgm similarity threshold for fuzzy product search fallback.
# When ILIKE finds nothing, trigram search catches typos (e.g. "mangoo" → "mango").
#AI_TRIGRAM_THRESHOLD=0.3

# Optional. Anonymous chat session TTL in days. Sessions older than this
# (by updated_at) are deleted by the daily cleanup cron job.
#AI_SESSION_TTL_DAYS=30

# ─── Optional: Query-Embedding Cache (KB search) ───────────────────────────
# Every chat message generates a Gemini text-embedding-004 vector for KB
# semantic search. Without caching, this hits Gemini's 1500 RPD free-tier
# quota at single-digit chats/min. With caching, repeat queries hit L1
# (in-process LRU, zero latency) or L2 (Redis, ~5ms) instead.
#
# The cache is multi-tier:
#   L1: in-process LRU Map (bounded by AI_QUERY_EMBEDDING_LRU_SIZE)
#   L2: Redis (shared across instances, requires UPSTASH_REDIS_REST_URL)
# Plus single-flight coalescing (concurrent identical queries share one
# Gemini call) and negative caching (failures cached with short TTL).
#
# TTL for positive (vector) cache entries, in seconds. Embeddings are
# deterministic for (text, model, taskType), so a long TTL is safe.
# Default: 6 hours (21600s).
#AI_QUERY_EMBEDDING_TTL_SECONDS=21600

# TTL for negative (null/failure) cache entries, in seconds. Short so
# transient failures (rate limit, network) recover quickly.
# Default: 60s.
#AI_QUERY_EMBEDDING_NEGATIVE_TTL_SECONDS=60

# Max entries in the L1 LRU cache. Each entry ≈ 6KB (768 floats × 8 bytes).
# Default: 256 (≈ 1.5MB max memory per process).
#AI_QUERY_EMBEDDING_LRU_SIZE=256

# ─── Optional: AI Feedback Email Digest (v2.5) ─────────────────────────────
# Weekly cron sends a digest of 👎 feedback to ADMIN_EMAIL. Requires
# RESEND_API_KEY (above) + ADMIN_EMAIL (already configured above).
# The cron endpoint is POST /api/cron/ai-feedback-digest — schedule it
# weekly (Mondays 9 AM) in your Vercel crons config or Render cron.
