{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/seller-subscriptions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/monthly-archive",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/low-stock",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
